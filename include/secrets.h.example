#pragma once
#include <TZ.h>

// Copy this file to secrets.h and fill in your own values.

// WiFi settings
const char* ssid = "yourssid";
const char* password = "yourpassw0rd";

// Spotify settings
String clientId = "API CLIENT ID";
String clientSecret = "API CLIENT SECRET";
// The device itself listens for the OAuth callback at http://<espotifierNodeName>.local/callback/
String espotifierNodeName = "esp8266";
// Spotify requires an HTTPS (or http://127.0.0.1) redirect URI, so this can no longer point
// directly at the device. Point it at a proxy you control (e.g. a localhost HTTPS server) that
// receives Spotify's redirect and forwards the "code" query param on to
// http://<espotifierNodeName>.local/callback/?code=... on the LAN. Must exactly match the
// redirect URI registered in the Spotify Developer Dashboard, URL-encoded.
String redirectUri = "https%3A%2F%2Fyourproxy.example.com%2Fcallback";

// Pick a timezone at https://github.com/esp8266/Arduino/blob/master/cores/esp8266/TZ.h#L389
#define TIMEZONE TZ_Europe_Zurich

#define MEMORY_DEBUG
